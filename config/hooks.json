{
  "_comment": "Hook 模块配置 — 让用户在 agent 关键执行点插入自定义逻辑（审计/通知/改写/拦截）",
  "enabled": true,
  "filters": {
    "_comment": "内置过滤器，配好即生效，不需写代码",
    "sensitive_words": [
      "password",
      "api_key",
      "apikey",
      "secret",
      "token",
      "密钥",
      "凭据",
      "密码"
    ],
    "block_patterns": [
      "rm -rf /",
      "format C:",
      "diskpart",
      "dd if=",
      "mkfs",
      "> /dev/sd",
      ":(){ :|:& };:"
    ]
  },
  "hooks": {
    "pre_tool": [
      {
        "matcher": "bash|write|file_mgr",
        "_comment": "高危工具调用时触发审计脚本",
        "hooks": []
      }
    ],
    "post_tool": [],
    "user_prompt": [],
    "notification": [],
    "denied": [],
    "stop": [],
    "pre_llm": [],
    "post_llm": [],
    "session_start": [],
    "session_end": [],
    "plan_approved": [],
    "task_complete": []
  }
}
