# 虚拟环境
.venv/
venv/
env/

# 旧配置文件备份
bak/

# 统一配置文件（含 API Key）
config.json

# 环境变量（含 API Key）
.env

# Python 缓存
__pycache__/
*.pyc
*.pyo

# 编辑器
.vscode/
.idea/

# 系统
.DS_Store
Thumbs.db

# 学习目录
code/

# 会话文件（用户本地，不提交）
sessions/

# 记忆系统（自动生成的对话归档）
memory/daily/
memory/config.json

# 日志文件（自动生成的调试日志）
log/

.review_diff.patch

.claude/

# Gateway 凭据（微信 token 等）
gateway/creds/

# Gateway 会话映射（session_key → session_id）
gateway/sessions_map.json

# Agent 工作目录（运行时生成）
workspace/
